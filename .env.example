# =============================================================================
# Vehicle Maintenance AI Agent — Environment Configuration
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vehicle_maintenance
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/vehicle_maintenance

# Redis
REDIS_URL=redis://localhost:6379/0

# Primary LLM Provider
PRIMARY_LLM_PROVIDER=groq
PRIMARY_LLM_MODEL=openai/gpt-oss-120b
PRIMARY_LLM_API_KEY=your_groq_api_key_here
PRIMARY_LLM_BASE_URL=https://api.groq.com/openai/v1


# Secondary LLM Provider
SECONDARY_LLM_PROVIDER=groq
SECONDARY_LLM_MODEL=qwen/qwen3.6-27b
SECONDARY_LLM_API_KEY=your_groq_api_key_here
SECONDARY_LLM_BASE_URL=https://api.groq.com/openai/v1

# Tertiary LLM Provider
TERTIARY_LLM_PROVIDER=
TERTIARY_LLM_MODEL=
TERTIARY_LLM_API_KEY=
TERTIARY_LLM_BASE_URL=

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=7860

# ML Model
ML_MODEL_PATH=models/maintenance_model.joblib
ML_PIPELINE_PATH=models/preprocessing_pipeline.joblib

# Frontend
VITE_API_URL=http://localhost:7860
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:7860/auth/callback

# Security
SECURE_COOKIES=false
